Option Explicit

Dim MDContent = [], fileHandle, fileName = Command(3)

If fileName <> "" Then
    Dim FileContent = []
    fileHandle = fOpen( fileName, "r" )
        While Not EoF( fileHandle )
           FileContent.Append( fGets( fileHandle ))
        End While
    fClose( fileHandle )
    MDContent = GetMDCode( FileContent )
    If MDContent.Length() = 0 Then MDContent = Help()
Else
    fileName = "Help"
    MDContent = Help()
End If


Const wxID_HTML = wxNewId(),  wxID_RTF = wxNewId()
Dim myFrame = New wxFrame( Nothing, -1, "", wxPoint( 100, 100 ), wxSize( 800, 600 ) ),
       myHTML = wxHtmlWindow( myFrame, -1, wxPoint( -1, -1 ), wxSize( -1, -1 ) ),
       myPopupMenu = New wxMenu()

       myHTML.SetPage( abMD2HTMLDoc( MDContent ))
       myPopupMenu.Append( wxID_SAVEAS, "Save as..." )
       myPopupMenu.AppendSeparator()
       myPopupMenu.Append( wxID_ABOUT, "About..." )
       myPopupMenu.Append( wxID_EXIT, "E&xit\tAlt-F4" )

     If Val(GetVersion()) >= 2.8 Then myFrame.SetIcon( wxIcon( Icon() ) )
     myFrame.SetTitle( "wxBMD 3.4 - " & fileName )
     myFrame.Show( True )


Sub ContextMenu( event )
    myFrame.PopupMenuXY( myPopupMenu, event.GetX(), event.GetY() )
   'myFrame.PopupMenu( myPopupMenu, myFrame.ScreenToClient( wxGetMousePosition() ))
End Sub
Connect( myHTML, wxEVT_RIGHT_DOWN, "ContextMenu" )


Sub onMenuSelected( event )
   Select Case event.GetID()
      Case wxID_EXIT   :   End
      Case wxID_ABOUT  :   wxMessageBox( "wxBMD\nVersion 3.4\nCopyright (c) 2026 Agustin Benitez Hernandez\n\nDocumenting wxBasic code using Markdown markup language.", "About wxBMD", wxOK | wxICON_INFORMATION )
      Case wxID_SAVEAS :   SaveAs()
   End Select
End sub
Connect( myFrame, wxID_SAVEAS, wxEVT_COMMAND_MENU_SELECTED, "onMenuSelected" )
Connect( myFrame, wxID_ABOUT,  wxEVT_COMMAND_MENU_SELECTED, "onMenuSelected" )
Connect( myFrame, wxID_EXIT,   wxEVT_COMMAND_MENU_SELECTED, "onMenuSelected" )


Function SaveAs()
    Const mySAVE_AS = 2 | 4   //  wxSAVE | wxOVERWRITE_PROMPT
    Dim myFileName = fileName, OutContent = ""
    If RInStr( fileName, "." ) > 0 Then myFileName = Left( fileName, RInStr( fileName, "." )-1 )
    Dim myDialog = New wxFileDialog( Nothing, "Save document as", "./", myFileName, "Markdown Format (*.md)|*.md|HTML Single Format (*.html)|*.htm;*.html|HTML Styled Format (*.html)|*.htm;*.html|Rich Text Format (*.rtf)|*.rtf|LaTeX Format (*.tex)|*.tex", mySAVE_AS )
    If myDialog.ShowModal() = wxID_OK Then
        Select Case myDialog.GetFilterIndex()
            Case 0 :  OutContent = abMD2MDDoc( MDContent )          ' Markdown
            Case 1 :  OutContent = abMD2HTMLDoc( MDContent )        ' HTML
            Case 2 :  OutContent = abMD2HTMLStyledDoc( MDContent )  ' HTML Styled
            Case 3 :  OutContent = abMD2RTFDoc( MDContent )         ' RTF
            Case 4 :  OutContent = abMD2TEXDoc( MDContent )         ' LaTeX
        End Select

       fileHandle = fOpen( myDialog.GetPath(), "w" )
           fPuts( fileHandle, OutContent )
       fClose( fileHandle )
    End If
    myDialog.Finalize() : myDialog = Nothing
End Function



///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\


Function abMD2MDDoc( mdText )
    Dim mdList = ArgType2List( mdText ), myDoc = ""
        For i=1 To mdList.Length()
            myDoc = myDoc & Replace( mdList[i], "\\\\\\", "\\" ) & "\n"
        End For
    Return myDoc
End Function


///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\


Function abMD2HTML( mdText )
    Dim mdList = ArgType2List( mdText ), myDoc = ""
        For i=2 To mdList.Length()-1
            myDoc = myDoc & HTMLParce( mdList[i], mdList[i-1], mdList[i+1] ) & "\n"
        End For
    Return myDoc
End Function

Function abMD2HTMLDoc( mdText, Title = "" )
    Dim mdList = ArgType2List( mdText ),
        myDoc = "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"iso-8859-1\">\n  <title>" & Title & "</title>\n</head>\n<body text=#000000>\n"
        myDoc &= wxBasicSyntaxHighlight( abMD2HTML( mdText ))
        myDoc &= "</body>\n</html>"
    Return myDoc
End Function


Function abMD2HTMLStyledDoc( mdText, Title = "" )
    Dim mdList = ArgType2List( mdText ),
        myDoc = "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"iso-8859-1\">\n  <title>" & Title & "</title>\n"
        myDoc &= "  <style type=\"text/css\">\n"
        myDoc &= "    html { margin: 0; height: inherit; } \n"
        myDoc &= "    body { font-family: Gill, Helvetica, sans-serif } \n"
        myDoc &= "    table { border-collapse: collapse; border: 1px solid black; } \n"
        myDoc &= "    td { padding: 5px; } \n"
        myDoc &= "    tr:nth-child(odd) {background-color: #f2f2f2;} \n"
        myDoc &= "    thead { background-color: #04AA6D; color: white; font-weight: bold; } \n"
        myDoc &= "    code { font-size: 15px; } \n"
        myDoc &= "  </style>\n"
        myDoc &= "</head>\n<body text=#000000>\n"
        myDoc &= wxBasicSyntaxHighlight( abMD2HTML( mdText ))
        myDoc &= "</body>\n</html>"
    Return myDoc
End Function


Function HTMLParce( Text, PTxt, NTxt )
    Static fBQ = False, fCB1 = False, fCB2 = False, fUL = False, fULs = False, fOL = False, fT = False
    Dim Out = Text

    If Trim( Text ) = "" Then Return ""

  ' HTML Entity
    //Out = Replace( Out, "&", "&amp;" )  :  Out = Replace( Out, "<", "&lt;" )  :  Out = Replace( Out, ">", "&gt;" )

  ' Open/close comment
    Dim BComm = InStr( Text, "[" ), EComm = InStr( Text, "]: #" )
    If EComm = 0 Then EComm = InStr( Text, "]:#" )
    If BComm=1 And EComm Then Return "<!-- " & Text[BComm+1:EComm-1] & " -->\n"

  ' Open/close code block 1
    If (LeftTrim( Text, 3 ) = "```" Or LeftTrim( Text, 3 ) = "~~~") And !fCB1 Then : fCB1 = True  : Return "<pre><code><!--wxBasic-->"   : End If
    If (LeftTrim( Text, 3 ) = "```" Or LeftTrim( Text, 3 ) = "~~~") And fCB1  Then : fCB1 = False : Return "</code></pre>" : End If
    If fCB1  Then Return Out

  ' Open/close code block 2
    If Text[1:4] = "    " Or Text[1] = Chr( 9 ) Then fCB2 = True
    If fCB2 Then : Out = FirstReplace( Out, Chr( 9 ), "" ) : Out = FirstReplace( Out, "    ", "" ) : End If
    If fCB2 And Trim( PTxt ) = "" Then : Return "<pre><code>\n" & Out
       ElseIf fCB2 And Trim( NTxt ) = "" Then : fCB2 = False : Return Out & "\n</code></pre>"
       ElseIf fCB2 Then : Return Out : End If

  ' Horizontal line
    If (LeftTrim( Text, 3 ) = "---" Or LeftTrim( Text, 3 ) = "***" Or LeftTrim( Text, 3 ) = "___") And Trim( PTxt ) = "" And Trim( NTxt ) = "" Then Return "<hr>"

  ' Link
    Dim Md = InStr( Out, "](" )
    If Md Then
       Dim Op = RInStr( Md, Out, "[" ),  Cl = InStr( Md, Out, ")" ),
           Ta = Out[1:Op-1],  Tb = Out[Op+1:Md-1],  Tc = Out[Md+2:Cl-1],  Td = Out[Cl+1:Len(Out)]
       Out = Ta & "<a href=\"" & Tc & "\">" & Tb & "</a>" & Td
    End If

  ' Titles
    If LeftTrim( Text, 1 ) = "#"      And Text[2] <> "#" Then Return "<h1>" & HTMLStyle( Trim( Replace( Out, "#", "" ))) & "</h1>"
    If LeftTrim( Text, 2 ) = "##"     And Text[3] <> "#" Then Return "<h2>" & HTMLStyle( Trim( Replace( Out, "#", "" ))) & "</h2>"
    If LeftTrim( Text, 3 ) = "###"    And Text[4] <> "#" Then Return "<h3>" & HTMLStyle( Trim( Replace( Out, "#", "" ))) & "</h3>"
    If LeftTrim( Text, 4 ) = "####"   And Text[5] <> "#" Then Return "<h4>" & HTMLStyle( Trim( Replace( Out, "#", "" ))) & "</h4>"
    If LeftTrim( Text, 5 ) = "#####"  And Text[6] <> "#" Then Return "<h5>" & HTMLStyle( Trim( Replace( Out, "#", "" ))) & "</h5>"
    If LeftTrim( Text, 6 ) = "######" And Text[7] <> "#" Then Return "<h6>" & HTMLStyle( Trim( Replace( Out, "#", "" ))) & "</h6>"
    If LeftTrim( NTxt, 3 ) = "===" Then Return "<h1>" & HTMLStyle( Trim( Out )) & "</h1>"
    If LeftTrim( Text, 3 ) = "===" And Trim( PTxt ) <> "" Then Return ""
    If LeftTrim( NTxt, 3 ) = "---" Then Return "<h2>" & HTMLStyle( Trim( Out )) & "</h2>"
    If LeftTrim( Text, 3 ) = "---" And Trim( PTxt ) <> "" Then Return ""

  ' Open/close table
    If LeftTrim( Text, 1 ) = "|" And Trim( PTxt ) = "" And !fT Then fT = True
    If fT And (LeftTrim( Text, 2 ) = "|-" Or LeftTrim( Text, 3 ) = "| -") Then Return "</thead>\n<tbody>"
    If fT Then Out = "<tr><td>" & HTMLStyle(Replace( Out, "|", "</td><td>" )) & "</td></tr>"
    If fT And Trim( PTxt ) = "" Then Out = "<table>\n<thead>\n<tr class=\"header\">\n" & Out
    If fT And Trim( NTxt ) = "" Then : fT = False : Out &= "\n</tbody>\n</table>" : End If

  ' Open/close unordered list
    Dim BgnBull = InStr( Text, "* " ) : If !BgnBull Then BgnBull = InStr( Text, "- " ) : If !BgnBull Then BgnBull = InStr( Text, "+ " )
    If (Text[1] = "*" Or Text[1] = "-" Or Text[1] = "+") And Text[2] = " " And Trim( PTxt ) = "" Then fUL = True
    If Text[1] = " " And (LeftTrim( Text, 1 ) = "*" Or LeftTrim( Text, 1 ) = "-" Or LeftTrim( Text, 1 ) = "+") And fUL Then fULs = True
    If fUL Or fULs Then Out = "<li>" & HTMLStyle( LTrim( Out[BgnBull+2:Length(Out)] )) & "</li>"
    If fULs And (PTxt[1] = "*" Or PTxt[1] = "-" Or PTxt[1] = "+") Then : Return "<ul>\n" & Out
       ElseIf fULs And (NTxt[1] = "*" Or NTxt[1] = "-" Or NTxt[1] = "+") Then : fULs = False : Return Out & "\n</ul>"
       ElseIf fULs Then : Return Out : End If
    If fUL And Trim( PTxt ) = "" Then : Return "<ul>\n" & Out
       ElseIf fUL And Trim( NTxt ) = "" Then : fUL = False : Return Out & "\n</ul>"
       ElseIf fUL Then : Return Out : End If

  ' Open/close ordered list
    Dim BgnNumb = InStr( Text, "." )
    If Text[1:2] = "1." Then fOL = True
    If fOL Then Out = "<li>" & HTMLStyle( LTrim( Out[BgnNumb+1:Length(Out)] )) & "</li>"
    If fOL And Trim( PTxt ) = "" Then : Return "<ol>\n" & Out
       ElseIf fOL And Trim( NTxt ) = "" Then : fOL = False : Return Out & "\n</ol>"
       ElseIf fUL Then : Return Out : End If

  ' Open/close paragraph
    If Trim( FirstReplace( PTxt, ">", "" )) = "" Then Out = "<p>" & Out
    If Trim( FirstReplace( NTxt, ">", "" )) = "" Then Out &= "</p>"

  ' Open/close blockquote
    If LeftTrim( Text, 1 ) = ">"  And Trim( PTxt ) = ""  Then fBQ = True
    If fBQ And Out[1] = ">" Then Out = LTrim( Out[2:Length(Out)] )
    If fBQ And Out[1:4] = "&gt;" Then Out = LTrim( Out[5:Length(Out)] )
    If fBQ And Out[1:4] = "<p>>" Then : Out = LTrim( FirstReplace( Out, "<p>> ", "<p>" )) : Out = LTrim( FirstReplace( Out, "<p>>", "<p>" )) : End If
    If fBQ And Out[1:7] = "<p>&gt;" Then : Out = LTrim( FirstReplace( Out, "<p>&gt; ", "<p>" )) : Out = LTrim( FirstReplace( Out, "<p>&gt;", "<p>" )) : End If
    If fBQ And Trim( PTxt ) = ""  Then Out = "<blockquote>\n" & Out
    If fBQ And Trim( NTxt ) = ""  Then : Out = Out & "\n</blockquote>" : fBQ = False : End If

  ' Line break
    If Right( Out, 2 ) = "  " Then Out = RTrim( Out ) & "<br>"

    Return HTMLStyle( Out )
End Function


Function HTMLStyle( Text )
    Static fB = False, fI = False, fIB= False, fS = False, fC = False, fH = False, fU = False, fD = False
    Const MaxRepl = 20
    Dim Out = Text

  ' UTF-8 to ANSI
    Dim Tbl = [ Chr(226)&Chr(130)&Chr(172), Chr(226)&Chr(130)&Chr(172), Chr(226)&Chr(128)&Chr(156), Chr(198)&Chr(146), Chr(226)&Chr(128)&Chr(158),
    Chr(226)&Chr(128)&Chr(166), Chr(226)&Chr(128)&Chr(160), Chr(226)&Chr(128)&Chr(161), Chr(203)&Chr(134), Chr(226)&Chr(128)&Chr(176), Chr(197)&Chr(160),
    Chr(226)&Chr(128)&Chr(185), Chr(197)&Chr(146), Chr(197)&Chr(146), Chr(197)&Chr(189), Chr(197)&Chr(189), Chr(197)&Chr(189), Chr(226)&Chr(128)&Chr(152),
    Chr(226)&Chr(128)&Chr(153), Chr(226)&Chr(128)&Chr(156), Chr(226)&Chr(128)&Chr(157), Chr(226)&Chr(128)&Chr(162), Chr(226)&Chr(128)&Chr(147),
    Chr(226)&Chr(128)&Chr(148), Chr(203)&Chr(156), Chr(226)&Chr(132)&Chr(162), Chr(197)&Chr(161), Chr(226)&Chr(128)&Chr(186), Chr(197)&Chr(147),
    Chr(197)&Chr(147), Chr(197)&Chr(190), Chr(197)&Chr(184)]
    For i=128 To 159 : Out = Replace( Out, Tbl[i-127], Chr(i) ) : End For
    For i=161 To 191 : Out = Replace( Out, Chr(194)&Chr(i), Chr(i) ) : End For
    For i=192 To 255 : Out = Replace( Out, Chr(195)&Chr(i-64), Chr(i) ) : End For

  ' Markdown escape characteres
    Out = Replace( Out, "\\-", "&#45;" )  :  Out = Replace( Out, "\\`", "&#96;" )  :  Out = Replace( Out, "\\*", "&#42;" )
    Out = Replace( Out, "\\_", "&#95;" )  :  Out = Replace( Out, "\\{", "&#123;" ) :  Out = Replace( Out, "\\}", "&#125;" )
    Out = Replace( Out, "\\#", "&#35;" )  :  Out = Replace( Out, "\\[", "&#91;" )  :  Out = Replace( Out, "\\]", "&#93;" )
    Out = Replace( Out, "\\+", "&#43;" )  :  Out = Replace( Out, "\\(", "&#40;" )  :  Out = Replace( Out, "\\)", "&#41;" )
    Out = Replace( Out, "\\.", "&#46;" )  :  Out = Replace( Out, "\\!", "&#33;" )  :  Out = Replace( Out, "\\=", "&#61;" )
    Out = Replace( Out, "\\|", "&#124;" ) :  Out = Replace( Out, "\\<", "&#60;" )  :  Out = Replace( Out, "\\>", "&#62;" )
    Out = Replace( Out, "\\^", "&#94;" )  :  Out = Replace( Out, "\\~", "&#126;" )
    Out = Replace( Out, "\\\\", "&#92;" )

  ' Open/close bold+italic
    For i=1 To MaxRepl
        If !fIB Then Out, fIB = FirstReplace( Out, ["***", "___", "**_", "__*", "_**", "*__"], "<i><b>" )
        If  fIB Then Out, fIB = FirstReplace( Out, ["***", "___", "**_", "__*", "_**", "*__"], "</b></i>", False )
    End For

  ' Open/close bold
    For i=1 To MaxRepl
        If !fB Then Out, fB = FirstReplace( Out, ["**", "__", "*_", "_*"], "<b>" )
        If  fB Then Out, fB = FirstReplace( Out, ["**", "__", "*_", "_*"], "</b>", False )
    End For

  ' Open/close italic
    For i=1 To MaxRepl
        If !fI Then Out, fI = FirstReplace( Out, ["*", "_"], "<i>" )
        If  fI Then Out, fI = FirstReplace( Out, ["*", "_"], "</i>", False )
    End For

  ' Open/close strikeout
    For i=1 To MaxRepl
        If !fS Then Out, fS = FirstReplace( Out, "~~", "<s>" )
        If  fS Then Out, fS = FirstReplace( Out, "~~", "</s>", False )
    End For

  ' Open/close code
    For i=1 To MaxRepl
        If !fC Then Out, fC = FirstReplace( Out, "`", "<code>" )
        If  fC Then Out, fC = FirstReplace( Out, "`", "</code>", False )
    End For

  ' Open/close highlight
    For i=1 To MaxRepl
        If !fH Then Out, fH = FirstReplace( Out, "==", "<mark>" )
        If  fH Then Out, fH = FirstReplace( Out, "==", "</mark>", False )
    End For

  ' Open/close superscript
    For i=1 To MaxRepl
        If !fU Then Out, fU = FirstReplace( Out, "^", "<sup>" )
        If  fU Then Out, fU = FirstReplace( Out, "^", "</sup>", False )
    End For

  ' Open/close subscript
    For i=1 To MaxRepl
        If !fD Then Out, fD = FirstReplace( Out, "~", "<sub>" )
        If  fD Then Out, fD = FirstReplace( Out, "~", "</sub>", False )
    End For

    Return Out
End Function


Function wxBasicSyntaxHighlight( mdText )
   Static fCB = False
   Dim mdList = ArgType2List( mdText ), Doc = "", Txt
   For i=1 To mdList.Length()
      Txt = mdList[i]
      If LCase( Txt[1:25] ) = "<pre><code><!--wxbasic-->"   Then fCB = True
      If LCase( Txt[1:13] ) = "</code></pre>" Then fCB = False
      If !fCB Then
         Doc &= Txt & "\n"
      Else
         Doc &= SyntaxHighlight( Txt ) & "\n"
      End If
   End For
   Return Doc
End Function


Function SyntaxHighlight( Text )
    Dim myList = [], Doc = Text

  ' Comments
    If InStr( Text, "'" ) Then
      myList = Split( "'", Text )
      If myList.Length() = 1 Then
         Return "<font color=#006400><i>'" & myList[1] & "</i></font>"
      Else
         Return KeysSyntaxHighlight( myList[1] ) & "<font color=#006400><i>'" & myList[2] & "</i></font>"
      End if
    End If
    If InStr( Text, "//" ) Then
      myList = Split( "//", Text )
      If myList.Length() = 1 Then
         Return "<font color=#006400><i>//" & myList[1] & "</i></font>"
      Else
         Return KeysSyntaxHighlight( myList[1] ) & "<font color=#006400><i>//" & myList[2] & "</i></font>"
      End if
    End If

  ' Strings
    If InStr( Text, "\"" ) Then
       Doc = ""
       myList = Split( "\"", Text )
       For i=1 To myList.Length() Step 2
         Doc &= KeysSyntaxHighlight( myList[i] )
         If i < myList.Length() Then Doc &= "<font color=#800080>\"" & myList[i+1] & "\"</font>"
       End For
       Return Doc
    End If
    Return KeysSyntaxHighlight( Doc )
End Function


Function KeysSyntaxHighlight( Text )
    Dim Key
    Const Key1 = ["Dim ","Constant","Const ","Print","Input","Then","Else","End If","End While","End For","While","String","Integer","Number",
                  "DateTime","Object","Array","Option Explicit","End Select","Select","Next","For Each","Exit For","Break","Continue",
                  "Finally","End Try",
                  "Catch","Redo","Try","Table","Case","List","End","For","New","If ","As ","In ","Is ","To "]
    Const Key2 = ["True","False","Nothing"]
    For Each Key In Key1
       Text = Replace( Text, Key, "<font color=#000090>" & Key & "</font>" )
       Text = Replace( Text, LCase( Key ), "<font color=#000090>" & LCase( Key ) & "</font>" )
       Text = Replace( Text, UCase( Key ), "<font color=#000090>" & UCase( Key ) & "</font>" )
    End For
    For Each Key In Key2
       Text = Replace( Text, Key, "<font color=#900000>" & Key & "</font>" )
       Text = Replace( Text, LCase( Key ), "<font color=#900000>" & LCase( Key ) & "</font>" )
       Text = Replace( Text, UCase( Key ), "<font color=#900000>" & UCase( Key ) & "</font>" )
    End For

    Return Text
End Function


///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\


Function abMD2RTF( mdText )
    Dim mdList = ArgType2List( mdText ), myDoc = ""
        For i=2 To mdList.Length()-1
            myDoc = myDoc & RTFParce( mdList[i], mdList[i-1], mdList[i+1] ) & "\n"
            myDoc = Replace( myDoc, "\\abXXXYYY", "\\*" )
            myDoc = Replace( myDoc, "&nbsp;", " " ) : myDoc = Replace( myDoc, "&#96;", "`" )
        End For
    Return myDoc
End Function


Function abMD2RTFDoc( mdText )
    Dim mdList = ArgType2List( mdText ),
        myDoc = "{\\rtf1\\ansi\\deff0\n\n"
        myDoc &= "{\\fonttbl\n{\\f0\\fnil\\fcharset0 Times New Roman;}\n{\\f1\\fmodern Courier New;}\n{\\f2\\ftech Symbol;}\n}\n"
        myDoc &= "{\\colortbl;\n\\red255\\green255\\blue0;\n\\red0\\green0\\blue238;\n}\n"
        myDoc &= abMD2RTF( mdText )
        myDoc &= "}\n"
    Return myDoc
End Function


Function RTFParce( Text, PTxt, NTxt )
    Static fBQ = False, fCB1 = False, fCB2 = False, fUL = False, fULs = False, fOL = False, fT = False
    Dim Out = Text

    If Trim( Text ) = "" Then Return ""

  ' HTML Entity
    //Out = Replace( Out, "&", "&amp;" )  :  Out = Replace( Out, "<", "&lt;" )  :  Out = Replace( Out, ">", "&gt;" )

  ' Open/close comment
    Dim BComm = InStr( Text, "[" ), EComm = InStr( Text, "]: #" )
    If EComm = 0 Then EComm = InStr( Text, "]:#" )
    If BComm=1 And EComm Then Return "{\\comment " & Text[BComm+1:EComm-1] & "}\n"

  ' Open/close code block 1
    If (LeftTrim( Text, 3 ) = "```" Or LeftTrim( Text, 3 ) = "~~~") And !fCB1 Then : fCB1 = True  : Return "{\\f1\\li500 "   : End If
    If (LeftTrim( Text, 3 ) = "```" Or LeftTrim( Text, 3 ) = "~~~") And fCB1  Then : fCB1 = False : Return "} \\par\\par\n" : End If
    If fCB1  Then Return Out & "\\par \n"

  ' Open/close code block 2
    If Text[1:4] = "    " Or Text[1] = Chr( 9 ) Then fCB2 = True
    If fCB2 Then : Out = FirstReplace( Out, Chr( 9 ), "" ) : Out = FirstReplace( Out, "    ", "" ) : End If
    If fCB2 And Trim( PTxt ) = "" Then : Return "{\\f1\\li500 " & Out
       ElseIf fCB2 And Trim( NTxt ) = "" Then : fCB2 = False : Return Out & "} \\par\\par\n"
       ElseIf fCB2 Then : Return Out & "\\par \n" : End If

  ' Horizontal line
    If (LeftTrim( Text, 3 ) = "---" Or LeftTrim( Text, 3 ) = "***" Or LeftTrim( Text, 3 ) = "___") And Trim( PTxt ) = "" And Trim( NTxt ) = "" Then Return "{________________________________________________________________________\\par\\par}\n"

  ' Link
    Dim Md = InStr( Out, "](" )
    If Md Then
       Dim Op = RInStr( Md, Out, "[" ),  Cl = InStr( Md, Out, ")" ),
           Ta = Out[1:Op-1],  Tb = Out[Op+1:Md-1],  Tc = Out[Md+2:Cl-1],  Td = Out[Cl+1:Len(Out)]
       Out = Ta &  " {\\field{\\abXXXYYY\\fldinst HYPERLINK \"" & Tc & "\"}{\\fldrslt{\\ul\\cf2 " & Tb & "}}}" & Td
    End If

  ' Titles
    If LeftTrim( Text, 1 ) = "#"      And Text[2] <> "#" Then Return "{\\pard\\fs40\\b " & RTFStyle( Trim( Replace( Out, "#", "" ))) & " \\par\\par}\n"
    If LeftTrim( Text, 2 ) = "##"     And Text[3] <> "#" Then Return "{\\pard\\fs32\\b " & RTFStyle( Trim( Replace( Out, "#", "" ))) & " \\par\\par}\n"
    If LeftTrim( Text, 3 ) = "###"    And Text[4] <> "#" Then Return "{\\pard\\fs28\\b " & RTFStyle( Trim( Replace( Out, "#", "" ))) & " \\par\\par}\n"
    If LeftTrim( Text, 4 ) = "####"   And Text[5] <> "#" Then Return "<h4>" & RTFStyle( Trim( Replace( Out, "#", "" ))) & "</h4>"
    If LeftTrim( Text, 5 ) = "#####"  And Text[6] <> "#" Then Return "<h5>" & RTFStyle( Trim( Replace( Out, "#", "" ))) & "</h5>"
    If LeftTrim( Text, 6 ) = "######" And Text[7] <> "#" Then Return "<h6>" & RTFStyle( Trim( Replace( Out, "#", "" ))) & "</h6>"
    If LeftTrim( NTxt, 3 ) = "===" Then Return "{\\pard\\fs40\\b " & RTFStyle( Trim( Out )) & " \\par\\par}\n"
    If LeftTrim( Text, 3 ) = "===" And Trim( PTxt ) <> "" Then Return ""
    If LeftTrim( NTxt, 3 ) = "---" Then Return "{\\pard\\fs32\\b " & RTFStyle( Trim( Out )) & " \\par\\par}\n"
    If LeftTrim( Text, 3 ) = "---" And Trim( PTxt ) <> "" Then Return ""

  ' Open/close table
    If LeftTrim( Text, 1 ) = "|" And Trim( PTxt ) = "" Then
         Dim TblInc = 200
         Out = "\\trowd\\cellx200\n"
         For I = 1 To Tally( Text, "|" )-1
             TblInc += 1500
             Out &= "\\cellx"& TblInc &"\n"
         End For
         Out &= "\\cellx"& TblInc+200 &"\n"
         fT = True
         Return Out & "{\\intbl {\\b " & RTFStyle( Replace( Text, "|", "}\\cell\\intbl {\\b " )) & "}\\cell\\row}"
    End If
    If fT And (LeftTrim( Text, 2 ) = "|-" Or LeftTrim( Text, 3 ) = "| -") Then Return ""
    If fT Then
       Out = ""
       If Trim( NTxt ) = "" Then : fT = False : Out = "\n\\par\n" : End If
       Return "{\\intbl " & RTFStyle( Replace( Text, "|", "\\cell\\intbl " )) & "\\cell\\row}" & Out
    End If

  ' Open/close unordered list
    Dim BgnBull = InStr( Text, "* " ) : If !BgnBull Then BgnBull = InStr( Text, "- " ) : If !BgnBull Then BgnBull = InStr( Text, "+ " )
    If (Text[1] = "*" Or Text[1] = "-" Or Text[1] = "+") And Text[2] = " " And Trim( PTxt ) = "" Then fUL = True
    If Text[1] = " " And (LeftTrim( Text, 1 ) = "*" Or LeftTrim( Text, 1 ) = "-" Or LeftTrim( Text, 1 ) = "+") And fUL Then fULs = True
    Dim Bull = "\\u8226*"  : If fULs Then Bull = "-"
    If fUL Or fULs Then Out = "{" & Bull & "\\tab} " & RTFStyle( LTrim( Out[BgnBull+2:Length(Out)] )) & " \\par\n"
    If fULs And (PTxt[1] = "*" Or PTxt[1] = "-" Or PTxt[1] = "+") Then : Return "{\\pard\\li1200\n" & Out
       ElseIf fULs And (NTxt[1] = "*" Or NTxt[1] = "-" Or NTxt[1] = "+") Then : fULs = False : Return Out & "\n}\n"
       ElseIf fULs Then : Return Out : End If
    If fUL And Trim( PTxt ) = "" Then : Return "{\\pard\\li580\n" & Out
       ElseIf fUL And Trim( NTxt ) = "" Then : fUL = False : Return Out & "\n\\par}\n"
       ElseIf fUL Then : Return Out : End If

  ' Open/close ordered list
    Dim BgnNumb = InStr( Text, "." )
    Static cnt
    If Text[1:2] = "1." Then : fOL = True : cnt = 0 : End If
    If fOL Then : cnt += 1 : Out = "{" & cnt & ".\\tab}" & RTFStyle( LTrim( Out[BgnNumb+1:Length(Out)] )) & "\\par" : End If
    If fOL And Trim( PTxt ) = "" Then : Return "{\\pard\\li480\n" & Out
       ElseIf fOL And Trim( NTxt ) = "" Then : fOL = False : Return Out & "\n\\par}\n"
       ElseIf fUL Then : Return Out : End If

  ' Open/close paragraph
    If Trim( FirstReplace( PTxt, ">", "" )) = "" Then Out = "{\\pard\\qj " & Out
    If Trim( FirstReplace( NTxt, ">", "" )) = "" Then Out &= " \\par\\par}\n"

  ' Open/close blockquote
    If LeftTrim( Text, 1 ) = ">"  And Trim( PTxt ) = ""  Then fBQ = True
    If fBQ Then Out = FirstReplace( Out, "> ", "" )
    If fBQ Then Out = FirstReplace( Out, ">", "" )
    If fBQ And Trim( PTxt ) = ""  Then Out = "" & Out
    If fBQ And Trim( NTxt ) = ""  Then : Out = Out & "" : fBQ = False : End If

  ' Line break
    If Right( Out, 2 ) = "  " Then Out = RTrim( Out ) & "\\par\n"

    Return RTFStyle( Out )
End Function


Function RTFStyle( Text )
    Static fB = False, fI = False, fIB= False, fS = False, fC = False, fH = False, fU = False, fD = False
    Const MaxRepl = 20
    Dim Out = Text

  ' UTF-8 to ANSI
    Dim Tbl = [ Chr(226)&Chr(130)&Chr(172), Chr(226)&Chr(130)&Chr(172), Chr(226)&Chr(128)&Chr(156), Chr(198)&Chr(146), Chr(226)&Chr(128)&Chr(158),
    Chr(226)&Chr(128)&Chr(166), Chr(226)&Chr(128)&Chr(160), Chr(226)&Chr(128)&Chr(161), Chr(203)&Chr(134), Chr(226)&Chr(128)&Chr(176), Chr(197)&Chr(160),
    Chr(226)&Chr(128)&Chr(185), Chr(197)&Chr(146), Chr(197)&Chr(146), Chr(197)&Chr(189), Chr(197)&Chr(189), Chr(197)&Chr(189), Chr(226)&Chr(128)&Chr(152),
    Chr(226)&Chr(128)&Chr(153), Chr(226)&Chr(128)&Chr(156), Chr(226)&Chr(128)&Chr(157), Chr(226)&Chr(128)&Chr(162), Chr(226)&Chr(128)&Chr(147),
    Chr(226)&Chr(128)&Chr(148), Chr(203)&Chr(156), Chr(226)&Chr(132)&Chr(162), Chr(197)&Chr(161), Chr(226)&Chr(128)&Chr(186), Chr(197)&Chr(147),
    Chr(197)&Chr(147), Chr(197)&Chr(190), Chr(197)&Chr(184)]
    For i=128 To 159 : Out = Replace( Out, Tbl[i-127], Chr(i) ) : End For
    For i=161 To 191 : Out = Replace( Out, Chr(194)&Chr(i), Chr(i) ) : End For
    For i=192 To 255 : Out = Replace( Out, Chr(195)&Chr(i-64), Chr(i) ) : End For

  ' Markdown escape characteres
    Out = Replace( Out, "\\-", "&#45;" )  :  Out = Replace( Out, "\\`", "&#96;" )  :  Out = Replace( Out, "\\*", "&#42;" )
    Out = Replace( Out, "\\_", "&#95;" )  :  Out = Replace( Out, "\\{", "&#123;" ) :  Out = Replace( Out, "\\}", "&#125;" )
    Out = Replace( Out, "\\#", "&#35;" )  :  Out = Replace( Out, "\\[", "&#91;" )  :  Out = Replace( Out, "\\]", "&#93;" )
    Out = Replace( Out, "\\+", "&#43;" )  :  Out = Replace( Out, "\\(", "&#40;" )  :  Out = Replace( Out, "\\)", "&#41;" )
    Out = Replace( Out, "\\.", "&#46;" )  :  Out = Replace( Out, "\\!", "&#33;" )  :  Out = Replace( Out, "\\=", "&#61;" )
    Out = Replace( Out, "\\|", "&#124;" ) :  Out = Replace( Out, "\\<", "&#60;" )  :  Out = Replace( Out, "\\>", "&#62;" )
    Out = Replace( Out, "\\^", "&#94;" )  :  Out = Replace( Out, "\\~", "&#126;" )
    Out = Replace( Out, "\\\\", "&#92;" ) :  Out = Replace( Out, "&#", "\\u" )

  ' Open/close bold+italic
    For i=1 To MaxRepl
        If !fIB Then Out, fIB = FirstReplace( Out, ["***", "___", "**_", "__*", "_**", "*__"], "{\\b\\i " )
        If  fIB Then Out, fIB = FirstReplace( Out, ["***", "___", "**_", "__*", "_**", "*__"], "}", False )
    End For

  ' Open/close bold
    For i=1 To MaxRepl
        If !fB Then Out, fB = FirstReplace( Out, ["**", "__", "*_", "_*"], "{\\b " )
        If  fB Then Out, fB = FirstReplace( Out, ["**", "__", "*_", "_*"], "}", False )
    End For

  ' Open/close italic
    For i=1 To MaxRepl
        If !fI Then Out, fI = FirstReplace( Out, ["*", "_"], "{\\i " )
        If  fI Then Out, fI = FirstReplace( Out, ["*", "_"], "}", False )
    End For

  ' Open/close strikeout
    For i=1 To MaxRepl
        If !fS Then Out, fS = FirstReplace( Out, "~~", "{\\strike " )
        If  fS Then Out, fS = FirstReplace( Out, "~~", "}", False )
    End For

  ' Open/close code
    For i=1 To MaxRepl
        If !fC Then Out, fC = FirstReplace( Out, "`", "{\\f1 " )
        If  fC Then Out, fC = FirstReplace( Out, "`", "}", False )
    End For

  ' Open/close highlight
    For i=1 To MaxRepl
        If !fH Then Out, fH = FirstReplace( Out, "==", "{\\highlight1" )
        If  fH Then Out, fH = FirstReplace( Out, "==", "}", False )
    End For

  ' Open/close superscript
    For i=1 To MaxRepl
        If !fU Then Out, fU = FirstReplace( Out, "^", "{\\super " )
        If  fU Then Out, fU = FirstReplace( Out, "^", "}", False )
    End For

  ' Open/close subscript
    For i=1 To MaxRepl
        If !fD Then Out, fD = FirstReplace( Out, "~", "{\\sub " )
        If  fD Then Out, fD = FirstReplace( Out, "~", "}", False )
    End For

    Return Out
End Function


///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\


Function abMD2TEX( mdText )
    Dim mdList = ArgType2List( mdText ), myDoc = ""
        For i=2 To mdList.Length()-1
            myDoc = myDoc & TEXParce( mdList[i], mdList[i-1], mdList[i+1] ) & "\n"
        End For
    Return myDoc
End Function


Function abMD2TEXDoc( mdText, Title = "" )
    Dim mdList = ArgType2List( mdText ),
        myDoc = "\\documentclass[english]{article}\n\\usepackage[T1]{fontenc}\n\\usepackage[latin1]{inputenc}\n\\usepackage{ulem}\n\\setlength{\\parskip}{\\medskipamount}\n\\setlength{\\parindent}{0pt}\n\\usepackage{babel}\n\\usepackage[colorlinks=true, urlcolor=blue]{hyperref}\n"
        myDoc &= "\\makeatletter\n\\newenvironment{mdcode}\n{\\par\\begin{list}{}{\n \\setlength{\\rightmargin}{\\leftmargin}\n \\setlength{\\listparindent}{0pt}\n \\raggedright\n \\setlength{\\itemsep}{0pt}\n \\setlength{\\parsep}{0pt}\n \\normalfont\\ttfamily}%\n\\item[]}\n{\\end{list}}\n\\makeatother\n"
        myDoc &= "\\begin{document}\n" & abMD2TEX( mdText )
        myDoc = Replace( myDoc, " \\abXYZXYZ", " \\\\" )
        myDoc = Replace( myDoc, "_", "\\_" ) : myDoc = Replace( myDoc, "#", "\\#" ) : myDoc = Replace( myDoc, "&", "\\&" )
        myDoc = Replace( myDoc, "$", "\\$" ) : myDoc = Replace( myDoc, "^", "\\textasciicircum " )
        myDoc = Replace( myDoc, "abAmpSubst", "&" )
        myDoc &= "\\end{document}\n"
    Return myDoc
End Function


Function TEXParce( Text, PTxt, NTxt )
    Static fBQ = False, fCB1 = False, fCB2 = False, fUL = False, fULs = False, fOL = False, fT = False
    Dim Out = Text

    If Trim( Text ) = "" Then Return ""

  ' HTML Entity
    //Out = Replace( Out, "&", "&amp;" )  :  Out = Replace( Out, "<", "&lt;" )  :  Out = Replace( Out, ">", "&gt;" )

  ' Open/close comment
    Dim BComm = InStr( Text, "[" ), EComm = InStr( Text, "]: #" )
    If EComm = 0 Then EComm = InStr( Text, "]:#" )
    If BComm=1 And EComm Then Return "% " & Text[BComm+1:EComm-1] & "\n"

  ' Open/close code block 1
    If (LeftTrim( Text, 3 ) = "```" Or LeftTrim( Text, 3 ) = "~~~") And !fCB1 Then : fCB1 = True  : Return "\\begin{mdcode}"   : End If
    If (LeftTrim( Text, 3 ) = "```" Or LeftTrim( Text, 3 ) = "~~~") And fCB1  Then : fCB1 = False : Return "\\end{mdcode}" : End If
    If fCB1  Then Return Out & "\n"

  ' Open/close code block 2
    If Text[1:4] = "    " Or Text[1] = Chr( 9 ) Then fCB2 = True
    If fCB2 Then : Out = FirstReplace( Out, Chr( 9 ), "" ) : Out = FirstReplace( Out, "    ", "" ) : End If
    If fCB2 And Trim( PTxt ) = "" Then : Return "\\begin{mdcode}\n" & Out
       ElseIf fCB2 And Trim( NTxt ) = "" Then : fCB2 = False : Return Out & "\n\\end{mdcode}"
       ElseIf fCB2 Then : Return Out & "\n" : End If

  ' Horizontal line
    If (LeftTrim( Text, 3 ) = "---" Or LeftTrim( Text, 3 ) = "***" Or LeftTrim( Text, 3 ) = "___") And Trim( PTxt ) = "" And Trim( NTxt ) = "" Then Return "\\rule[0.5ex]{1\\columnwidth}{1pt}\n"

  ' Link
    Dim Md = InStr( Out, "](" )
    If Md Then
       Dim Op = RInStr( Md, Out, "[" ),  Cl = InStr( Md, Out, ")" ),
           Ta = Out[1:Op-1],  Tb = Out[Op+1:Md-1],  Tc = Out[Md+2:Cl-1],  Td = Out[Cl+1:Len(Out)]
       Out = Ta & "\\href{" & Tc & "}{\\uline{" & Tb & "}}" & Td
    End If

  ' Titles
    If LeftTrim( Text, 1 ) = "#"      And Text[2] <> "#" Then Return "\\section*{" & TEXStyle( Trim( Replace( Out, "#", "" ))) & "}"
    If LeftTrim( Text, 2 ) = "##"     And Text[3] <> "#" Then Return "\\subsection*{" & TEXStyle( Trim( Replace( Out, "#", "" ))) & "}"
    If LeftTrim( Text, 3 ) = "###"    And Text[4] <> "#" Then Return "\\subsubsection*{" & TEXStyle( Trim( Replace( Out, "#", "" ))) & "}"
    If LeftTrim( Text, 4 ) = "####"   And Text[5] <> "#" Then Return "\\paragraph*{" & TEXStyle( Trim( Replace( Out, "#", "" ))) & "}"
    If LeftTrim( Text, 5 ) = "#####"  And Text[6] <> "#" Then Return "\\subparagraph*{" & TEXStyle( Trim( Replace( Out, "#", "" ))) & "}"
    If LeftTrim( Text, 6 ) = "######" And Text[7] <> "#" Then Return "\\subparagraph*{" & TEXStyle( Trim( Replace( Out, "#", "" ))) & "}"
    If LeftTrim( NTxt, 3 ) = "===" Then Return "\\section*{" & TEXStyle( Trim( Out )) & "}"
    If LeftTrim( Text, 3 ) = "===" And Trim( PTxt ) <> "" Then Return ""
    If LeftTrim( NTxt, 3 ) = "---" Then Return "\\subsection*{" & TEXStyle( Trim( Out )) & "}"
    If LeftTrim( Text, 3 ) = "---" And Trim( PTxt ) <> "" Then Return ""

  ' Open/close table
    If LeftTrim( Text, 1 ) = "|" And Trim( PTxt ) = "" Then
         Out = ""
         For I = 1 To Tally( Text, "|" )+1
             Out &= "l"
         End For
         fT = True
         Return "\\begin{tabular}{" & Out & "}\n\\textbf{" & TEXStyle( Replace( Text, "|", "} abAmpSubst \\textbf{" )) & "}\\\\"
    End If
    If fT And (LeftTrim( Text, 2 ) = "|-" Or LeftTrim( Text, 3 ) = "| -") Then Return "\\hline\n"
    If fT Then
       Out = ""
       If Trim( NTxt ) = "" Then : fT = False : Out = "\n\\end{tabular}" : End If
       Return TEXStyle( Replace( Text, "|", "abAmpSubst" )) & "\\\\" & Out
    End If

  ' Open/close unordered list
    Dim BgnBull = InStr( Text, "* " ) : If !BgnBull Then BgnBull = InStr( Text, "- " ) : If !BgnBull Then BgnBull = InStr( Text, "+ " )
    If (Text[1] = "*" Or Text[1] = "-" Or Text[1] = "+") And Text[2] = " " And Trim( PTxt ) = "" Then fUL = True
    If Text[1] = " " And (LeftTrim( Text, 1 ) = "*" Or LeftTrim( Text, 1 ) = "-" Or LeftTrim( Text, 1 ) = "+") And fUL Then fULs = True
    If fUL Or fULs Then Out = "\\item " & TEXStyle( LTrim( Out[BgnBull+2:Length(Out)] ))
    If fULs And (PTxt[1] = "*" Or PTxt[1] = "-" Or PTxt[1] = "+") Then : Return "\\begin{itemize}\n" & Out
       ElseIf fULs And (NTxt[1] = "*" Or NTxt[1] = "-" Or NTxt[1] = "+") Then : fULs = False : Return Out & "\n\\end{itemize}"
       ElseIf fULs Then : Return Out : End If
    If fUL And Trim( PTxt ) = "" Then : Return "\\begin{itemize}\n" & Out
       ElseIf fUL And Trim( NTxt ) = "" Then : fUL = False : Return Out & "\n\\end{itemize}"
       ElseIf fUL Then : Return Out : End If

  ' Open/close ordered list
    Dim BgnNumb = InStr( Text, "." )
    If Text[1:2] = "1." Then fOL = True
    If fOL Then Out = "\\item " & TEXStyle( LTrim( Out[BgnNumb+1:Length(Out)] ))
    If fOL And Trim( PTxt ) = "" Then : Return "\\begin{enumerate}\n" & Out
       ElseIf fOL And Trim( NTxt ) = "" Then : fOL = False : Return Out & "\n\\end{enumerate}"
       ElseIf fUL Then : Return Out : End If

  ' Open/close paragraph
    If Trim( FirstReplace( PTxt, ">", "" )) = "" Then Out = "" & Out
    If Trim( FirstReplace( NTxt, ">", "" )) = "" Then Out &= " \\abXYZXYZ"

  ' Open/close blockquote
    If LeftTrim( Text, 1 ) = ">"  And Trim( PTxt ) = ""  Then fBQ = True
    If fBQ And Out[1] = ">" Then Out = LTrim( Out[2:Length(Out)] )
    If fBQ And Out[1:4] = "&gt;" Then Out = LTrim( Out[5:Length(Out)] )
    If fBQ And Out[1:4] = "<p>>" Then : Out = LTrim( FirstReplace( Out, "<p>> ", "<p>" )) : Out = LTrim( FirstReplace( Out, "<p>>", "<p>" )) : End If
    If fBQ And Out[1:7] = "<p>&gt;" Then : Out = LTrim( FirstReplace( Out, "<p>&gt; ", "<p>" )) : Out = LTrim( FirstReplace( Out, "<p>&gt;", "<p>" )) : End If
    If fBQ And Trim( PTxt ) = ""  Then Out = "\\hspace{0.05\\columnwidth}\\parbox[t]{0.95\\columnwidth}{%\n" & Out
    If fBQ And Trim( NTxt ) = ""  Then : Out = Out & "}" : fBQ = False : End If

  ' Line break
    If Right( Out, 2 ) = "  " Then Out = RTrim( Out ) & " \\abXYZXYZ"

    Return TEXStyle( Out )
End Function


Function TEXStyle( Text )
    Static fB = False, fI = False, fIB= False, fS = False, fC = False, fH = False, fU = False, fD = False
    Const MaxRepl = 20
    Dim Out = Text

  ' UTF-8 to ANSI
    Dim Tbl = [ Chr(226)&Chr(130)&Chr(172), Chr(226)&Chr(130)&Chr(172), Chr(226)&Chr(128)&Chr(156), Chr(198)&Chr(146), Chr(226)&Chr(128)&Chr(158),
    Chr(226)&Chr(128)&Chr(166), Chr(226)&Chr(128)&Chr(160), Chr(226)&Chr(128)&Chr(161), Chr(203)&Chr(134), Chr(226)&Chr(128)&Chr(176), Chr(197)&Chr(160),
    Chr(226)&Chr(128)&Chr(185), Chr(197)&Chr(146), Chr(197)&Chr(146), Chr(197)&Chr(189), Chr(197)&Chr(189), Chr(197)&Chr(189), Chr(226)&Chr(128)&Chr(152),
    Chr(226)&Chr(128)&Chr(153), Chr(226)&Chr(128)&Chr(156), Chr(226)&Chr(128)&Chr(157), Chr(226)&Chr(128)&Chr(162), Chr(226)&Chr(128)&Chr(147),
    Chr(226)&Chr(128)&Chr(148), Chr(203)&Chr(156), Chr(226)&Chr(132)&Chr(162), Chr(197)&Chr(161), Chr(226)&Chr(128)&Chr(186), Chr(197)&Chr(147),
    Chr(197)&Chr(147), Chr(197)&Chr(190), Chr(197)&Chr(184)]
    For i=128 To 159 : Out = Replace( Out, Tbl[i-127], Chr(i) ) : End For
    For i=161 To 191 : Out = Replace( Out, Chr(194)&Chr(i), Chr(i) ) : End For
    For i=192 To 255 : Out = Replace( Out, Chr(195)&Chr(i-64), Chr(i) ) : End For

  ' Markdown escape characteres
    Out = Replace( Out, "\\-", "\\symbol{45}" )  :  Out = Replace( Out, "\\`", "\\symbol{96}" )  :  Out = Replace( Out, "\\*", "\\symbol{42}" )
    Out = Replace( Out, "\\_", "\\symbol{95}" )  :  Out = Replace( Out, "\\{", "\\symbol{123}" ) :  Out = Replace( Out, "\\}", "\\symbol{125}" )
    Out = Replace( Out, "\\#", "\\symbol{35}" )  :  Out = Replace( Out, "\\[", "\\symbol{91}" )  :  Out = Replace( Out, "\\]", "\\symbol{93}" )
    Out = Replace( Out, "\\+", "\\symbol{43}" )  :  Out = Replace( Out, "\\(", "\\symbol{40}" )  :  Out = Replace( Out, "\\)", "\\symbol{41}" )
    Out = Replace( Out, "\\.", "\\symbol{46}" )  :  Out = Replace( Out, "\\!", "\\symbol{33}" )  :  Out = Replace( Out, "\\=", "\\symbol{61}" )
    Out = Replace( Out, "\\|", "\\symbol{124}" ) :  Out = Replace( Out, "\\<", "\\symbol{60}" )  :  Out = Replace( Out, "\\>", "\\symbol{62}" )
    Out = Replace( Out, "\\^", "\\symbol{94}" )  :  Out = Replace( Out, "\\~", "\\symbol{126}" )
    Out = Replace( Out, "\\\\", "\\symbol{92}" )

  ' Open/close bold+italic
    For i=1 To MaxRepl
        If !fIB Then Out, fIB = FirstReplace( Out, ["***", "___", "**_", "__*", "_**", "*__"], "\\textbf{\\textit{" )
        If  fIB Then Out, fIB = FirstReplace( Out, ["***", "___", "**_", "__*", "_**", "*__"], "}}", False )
    End For

  ' Open/close bold
    For i=1 To MaxRepl
        If !fB Then Out, fB = FirstReplace( Out, ["**", "__", "*_", "_*"], "\\textbf{" )
        If  fB Then Out, fB = FirstReplace( Out, ["**", "__", "*_", "_*"], "}", False )
    End For

  ' Open/close italic
    For i=1 To MaxRepl
        If !fI Then Out, fI = FirstReplace( Out, ["*", "_"], "\\textit{" )
        If  fI Then Out, fI = FirstReplace( Out, ["*", "_"], "}", False )
    End For

  ' Open/close strikeout
    For i=1 To MaxRepl
        If !fS Then Out, fS = FirstReplace( Out, "~~", "\\sout{" )
        If  fS Then Out, fS = FirstReplace( Out, "~~", "}", False )
    End For

  ' Open/close code
    For i=1 To MaxRepl
        If !fC Then Out, fC = FirstReplace( Out, "`", "\\texttt{" )
        If  fC Then Out, fC = FirstReplace( Out, "`", "}", False )
    End For

  ' Open/close highlight
    For i=1 To MaxRepl
        If !fH Then Out, fH = FirstReplace( Out, "==", "\\uline{" )
        If  fH Then Out, fH = FirstReplace( Out, "==", "}", False )
    End For

  ' Open/close superscript
    For i=1 To MaxRepl
        If !fU Then Out, fU = FirstReplace( Out, "^", "\\textsuperscript{" )
        If  fU Then Out, fU = FirstReplace( Out, "^", "}", False )
    End For

  ' Open/close subscript
    For i=1 To MaxRepl
        If !fD Then Out, fD = FirstReplace( Out, "~", "\\textsubscript{" )
        If  fD Then Out, fD = FirstReplace( Out, "~", "}", False )
    End For

    Return Out
End Function


///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\///\\\


Function ArgType2List( mdText )
    Dim mdList = [], i, n
    Select Case LCase( TypeOf( mdText ))
        Case "list"
            mdList = mdText
        Case "string"
            mdText = Replace( mdText, "\r", "" )
            mdList = Split( "\n", mdText )
        Case "array"
            For i=LBound( mdText, 1 ) To UBound( mdText, 1 )
                mdList.Append( mdText[i] )
            End For
        Case "table"
            For Each i, n In mdText
                mdList.Append( n )
            End For
        Case "integer", "number"
            mdList.Append( Str( mdText ))
    End Select
    mdList.Append( " " ) : mdList.Prepend( " " )
    Return mdList
End Function


Function Split( Pattern, myString )
    Dim SplitList = [], InitPos = 1, EndPos
    For I = 1 To Tally( myString, Pattern )
        EndPos = InStr( InitPos, myString, Pattern )
        If EndPos > InitPos Then SplitList.Append( myString[ InitPos:EndPos-1 ])
        InitPos = EndPos + Len( Pattern )
    End For
    If Len( myString ) > InitPos Then SplitList.Append( myString[ InitPos:Len( myString )])
    Return SplitList
End Function


Function FirstReplace( Text, Pattern, Repl, Bool = True )
    Dim Patt = [], FirstPos = 1000000, FirstText, Pos
    If LCase( TypeOf( Pattern )) = "string" Then : Patt.Append( Pattern ) : Else : Patt = Pattern : End If
    For i=1 To Patt.Length()
       Pos = InStr( Text, Patt[i] )
       If Pos > 0 And Pos < FirstPos Then : FirstPos = Pos : FirstText = Patt[i] : End If
    End For
    If FirstPos = 1000000 Then Return Text, !Bool
    Return Text[1: FirstPos-1] & Repl & Text[FirstPos+Len(FirstText):Len(Text)] , Bool
End Function


Function LeftTrim( Text, Chars )
    Return Left( LTrim( Text ), Chars )
End Function


Function GetMDCode( Content )
   Dim MDContent = [], ContentLine, MinSpac = 100, Spac
   For I = 1 To Content.Length()
       ContentLine = LTrim( Content[i] )
       If ContentLine[1] = "'" Then  :         ContentLine = ContentLine[2:Len(ContentLine)]
       ElseIf ContentLine[1:2] = "//" Then  :  ContentLine = ContentLine[3:Len(ContentLine)]
       Else  :  Exit For
       End If
       Spac = Len( ContentLine ) - Len( LTrim( ContentLine ))
       If Len( LTrim( ContentLine )) = 0 Then Spac = 100
       If Spac < MinSpac Then MinSpac = Spac
       MDContent.Append( ContentLine )
   End For
   For I = 1 To MDContent.Length()
       MDContent[i] = Right( MDContent[i], Len( MDContent[i] ) - MinSpac )
   End For
   Return MDContent
End Function


Function GetVersion()
    Dim pun = InStr(WXBASIC_VERSION, "."),
        ini = RInStr(pun, WXBASIC_VERSION, " ")+1,
        fin = InStr(pun, WXBASIC_VERSION, " ")-ini,
        ver = Mid(WXBASIC_VERSION, ini, fin)
        ver = Replace(ver, ".0.", ".00.")
    Return Replace(ver, ".0", ".")
End Function


Function Help()
    Return [
       "# wxBMD Help",
       "",
       "*Basic Markdown Documentation* (**BMD**) is a lightweight markup language used to document the wxBasic programming language, modules, and programs; using Markdown markup language.",
       "",
       "BMD is designed to be a simple, clean markup language with just enough syntax to be useful. Some of its goals are:",
       "",
       "* Easy to parse;",
       "* Easy to convert to other formats, such as Markdown, HTML, Rich Text Format (RTF), or LaTeX, through `Save as` option on right-click menu",
       "* Easy to incorporate sample code;",
       "* Easy to read without a BMD parser (i.e., in its source-code form);",
       "* Easy to write.",
       "",
       "### BMD Syntax",
       "",
       "* The BMD parser assumes that all initial lines beginning with consecutive wxBasic comments (`'` or `//`)  containing BMD documentation.",
       "* BMD documentation ends when the first uncommented line appears. Any subsequent content is ignored by the parser.",
       "* Any indentation to the left of the comment symbol is ignored.",
       "* The indentation to the right of the comment symbol is ignored, if it is the same on all lines. Additional indentation on one or more specific lines is considered part of the Markdown code (in a code blocks or a nest list).",
       "",
       "**Example:**",
       "",
       "```",
       "' BMD Title",
       "' ---------",
       " ' ",
       "' BMD paragraph",
       "Print \"wxBasic code\"",
       "' Another wxBasic comment, but not BMD text",
       "```",
       "",
       "------",
       "",
       "## Quick Markdown Guide",
       "",
       "> __NOTE:__ For a full Markdown guide see: **CONE, M. (2020)** [___The Markdown Guide___](https://dl.icdst.org/pdfs/files3/c79990b0b853932d36ddc117ce2503e3.pdf). 83 pages. ISBN 979-8656504492.  ",
       "",
       "## Characters Encodings",
       "",
       "The characters of MD text can be encoded, preferably, as:",
       "",
       "* *Windows-1252* encoding (aka *ANSI* code page)",
       "* *UTF-8* encoding",
       "",
       "**NOTE:** Although UTF-8 encoding allows the representation of more than 143,000 Unicode characters, ",
       "only the 256 corresponding to ANSI encoding are supported here.",
       "",
       "Due to its similarity to *Windows-1252* encoding, the following codes are also accepted:",
       "",
       "* *ISO-8859-1* (aka *Latin 1*)",
       "* *ISO-8859-15* (aka *Latin 9*)",
       "",
       "**Example:**",
       "",
       "ANSI encoding:  Á É Í Ó Ú Ü Ñ á é í ó ú ü ñ ¡ ¿  ",
       "UTF-8 encoding: Á É Í Ó Ú Ü Ñ á é í ó ú ü ñ ¡ ¿  ",
       "",
       "",
       "## Escaping Characters",
       "",
       "To display a literal character that would otherwise be used to format text in a Markdown document, ",
       "add a *backslash* (\\\\) in front of the character. You can use a *backslash* to escape the following characters:",
       "",
       "* ` \\\\\\\\ ` 	Backslash",
       "* ` \\\\\\` ` 	Backtick",
       "* ` \\\\\\* ` 	Asterisk",
       "* ` \\\\\\_ ` 	Underscore",
       "* ` \\\\\\{ ` 	Open curly braces",
       "* ` \\\\\\} ` 	Close curly braces",
       "* ` \\\\\\[ ` 	Open brackets",
       "* ` \\\\\\] ` 	Close brackets",
       "* ` \\\\\\< ` 	Open angle brackets",
       "* ` \\\\\\> ` 	Close angle brackets",
       "* ` \\\\\\( ` 	Open parentheses",
       "* ` \\\\\\) ` 	Close parentheses",
       "* ` \\\\\\# ` 	Number sign",
       "* ` \\\\\\+ ` 	Plus sign",
       "* ` \\\\\\- ` 	Minus sign (hyphen)",
       "* ` \\\\\\. ` 	Dot",
       "* ` \\\\\\! ` 	Exclamation mark",
       "* ` \\\\\\| ` 	Pipe",
       "* ` \\\\\\= ` 	Equals sign",
       "* ` \\\\\\^ ` 	Caret",
       "* ` \\\\\\~ ` 	Tilde",
       "",
       "",
       "## Bold",
       "",
       "To bold text, add *two asterisks* (\\*\\*) or *two underscores* (\\_\\_) before and after a word or phrase. To bold the middle of a word for emphasis, add *two asterisks without spaces* around the letters.",
       "",
       "**Example:**",
       "",
       "```",
       "  I just love **bold text**.",
       "  I just love __bold text__.",
       "  IJust**LoveBold**Text.",
       "```",
       "",
       "**Result:**",
       "",
       "I just love **bold text**.   ",
       "I just love __bold text__.   ",
       "IJust**LoveBold**Text.",
       "",
       "",
       "## Italic",
       "",
       "To italicize text, add *one asterisk* (\\*) or *one underscore* (\\_) before and after a word or phrase. To italicize the middle of a word for emphasis, add *one asterisk without spaces* around the letters.",
       "",
       "**Example:**",
       "",
       "```",
       "  Italicized text is the *cat´s meow*.",
       "  Italicized text is the _cat´s meow_.",
       "  Italicized*TextIsThe*Cat´sMeow.",
       "```",
       "",
       "**Result:**",
       "",
       "Italicized text is the *cat's meow*.  ",
       "Italicized text is the _cat's meow_.  ",
       "Italicized*TextIsThe*Cat&#39;sMeow.",
       "",
       "",
       "## Bold and Italic",
       "",
       "To emphasize text with bold and italics at the same time, add *three asterisks* (\\*\\*\\*) or *three underscores* (\\_\\_\\_) or any combination of these before and after a word or phrase. To bold and italicize the middle of a word for emphasis, add three asterisks without spaces around the letters.",
       "",
       "**Example:**",
       "",
       "```",
       "  Text ***really important***.",
       "  Text ___really important___.",
       "  Text __*really important*__.",
       "  Text **_really important_**.",
       "  Text *__really important__*.",
       "  Text _**really important**_.",
       "  Text***Really***Important.",
       "```",
       "",
       "**Result:**",
       "",
       "Text ***really important***.   ",
       "Text ___really important___.   ",
       "Text __*really important*__.   ",
       "Text **_really important_**.   ",
       "Text *__really important__*.   ",
       "Text _**really important**_.   ",
       "Text***Really***Important.",
       "",
       "",
       "## Code",
       "",
       "To denote a word or phrase as code, enclose it in *backticks* (\\`).",
       "",
       "**Example:**",
       "",
       "```",
       "  At the command prompt, type: `ATTRIB -R -H *.* /S/D`",
       "```",
       "",
       "**Result:**",
       "",
       "At the command prompt, type: `ATTRIB -R -H \\*.\\* /S/D`",
       "",
       "",
       "## Highlight",
       "",
       "To highlight words, use *two equal signs* (\\=\\=) before and after the words.",
       "",
       "**Example:**",
       "",
       "```",
       "  I need to highlight these ==very important words==.",
       "```",
       "",
       "**Result:**",
       "",
       "I need to highlight these ==very important words==.",
       "",
       "",
       "## Subscript",
       "",
       "To create a subscript, use *one tilde symbol* (\\~) before and after the characters.",
       "",
       "**Example:**",
       "",
       "```",
       "  H~2~SO~4~ : sulfuric acid",
       "```",
       "",
       "**Result:**",
       "",
       "H~2~SO~4~ : sulfuric acid",
       "",
       "",
       "## Superscript",
       "",
       "To create a superscript, use *one caret symbol* (\\^) before and after the characters.",
       "",
       "**Example:**",
       "",
       "```",
       "  y = 2x^3^ + 6x^2^ - x + 5  : a polynomial equation",
       "```",
       "",
       "**Result:**",
       "",
       "y = 2x^3^ \\+ 6x^2^ \\- x \\+ 5  : a polynomial equation",
       "",
       "",
       "------",
       "",
       "## Headings",
       "",
       "To create a heading, add *number signs* (\\#) in front of a phrase. For compatibility, always put a space between the *number signs* (\\#) and the heading name. The number of *number signs* you use should correspond to the title level:",
       "",
       "```",
       "  #  Heading level 1",
       "  ##  Heading level 2",
       "  ###  Heading level 3",
       "  ####  Heading level 4",
       "  #####  Heading level 5",
       "  ######  Heading level 6",
       "```",
       "",
       "### Heading Alternate Syntax",
       "",
       "Alternatively, on the line below the text, underline with any number of \\=\\= characters for heading level 1",
       "or \\-\\- characters for heading level 2.",
       "",
       "```",
       "  Heading level 1",
       "  ===============",
       "  Heading level 2",
       "  ---------------",
       "```",
       "",
       "",
       "## Paragraphs",
       "",
       "To create paragraphs, use a *blank line* to separate one or more lines of text. Don't indent paragraphs with spaces or tabs.",
       "",
       "",
       "## Line Breaks",
       "",
       "To create a line break or new line,   ",
       "end a line with *two or more spaces*, and then type return.",
       "",
       "",
       "## Blockquotes",
       "",
       "To create a blockquote, add a *greater than sign* (>) in front of a paragraph. For compatibility, put blank lines before and after blockquotes.",
       "",
       "**Example:**",
       "",
       "```",
       "  > Dorothy followed her through many of the beautiful rooms in her castle.",
       "```",
       "",
       "**Result:**",
       "",
       "> Dorothy followed her through many of the beautiful rooms in her castle.",
       "",
       "### Blockquotes with Multiple Paragraphs",
       "",
       "Blockquotes can contain multiple paragraphs. Add a greater than sign (>) on the blank lines between the paragraphs.",
       "",
       "**Example:**",
       "",
       "```",
       "  > Dorothy followed her through many of the beautiful rooms in her castle.",
       "  >",
       "  > The Witch bade her clean the pots and kettles and sweep the floor and keep the fire fed with wood.",
       "```",
       "",
       "**Result:**",
       "",
       "> Dorothy followed her through many of the beautiful rooms in her castle.",
       ">",
       "> The Witch bade her clean the pots and kettles and sweep the floor and keep the",
       "fire fed with wood.",
       "",
       "",
       "## Links",
       "",
       "To create a link, enclose the link text in brackets and then follow it immediately with the URL in",
       "parentheses.",
       "",
       "**Example:**",
       "",
       "`Use &#91;Google&#93;(http://www.google.com/) to find.`",
       "",
       "**Result:**",
       "",
       "Use [Google](http://www.google.com/) to find.",
       "",
       "",
       "## Horizontal Rules",
       "",
       "To create a horizontal rule, use three or more *asterisks* (\\*\\*\\*), *dashes* (\\-\\-\\-), or ",
       "*underscores* (\\_\\_\\_) on a line by themselves.",
       "",
       "**Example:**",
       "",
       "`\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-`",
       "",
       "**Result:**",
       "",
       "-------",
       "",
       "",
       "## Unordered Lists",
       "",
       "To create an unordered list, add *dashes* (\\-), *asterisks* (\\*), or *plus signs* (\\+) in front of line items.",
       "Always use a blank space after the symbol to avoid confusing it with the emphasized fonts. ",
       "A blank line after the last item indicates the end of the list.",
       "",
       "**Example:**",
       "",
       "```",
       "   - First item",
       "   * Second item",
       "   + Third item",
       "   - Fourth item",
       "```",
       "",
       "**Result:**",
       "",
       "- First item",
       "* Second item",
       "+ Third item",
       "- Fourth item ",
       "",
       "",
       "## Nested Unordered Lists",
       "",
       "To create an nested unordered list indent one or more items before *dashes* (\\-), *asterisks* (\\*), or *plus signs* (\\+).",
       "",
       "**Example:**",
       "",
       "```",
       "   * First item",
       "     - First subitem",
       "     - Second subitem",
       "   * Second item",
       "   * Third item",
       "```",
       "",
       "**Result:**",
       "",
       "* First item",
       "  - First subitem",
       "  - Second subitem",
       "* Second item",
       "* Third item",
       "",
       "",
       "## Ordered Lists",
       "",
       "To create an ordered list, add line items with *numbers followed by periods*. The numbers don't have to be in numerical order, and the numbers may even be repeated, but the list should **start with the number one**.",
       "",
       "**Example:**",
       "",
       "```",
       "   1.  First item",
       "   15. Second item",
       "   15. Third item",
       "   8.  Fourth item",
       "```",
       "",
       "**Result:**",
       "",
       "1.  First item",
       "15. Second item",
       "15. Third item",
       "8.  Fourth item ",
       "",
       "",
       "------",
       "",
       "## Tables",
       "",
       "To add a table, use *pipes* (\\|) to separate each column. Use three o more *hyphens* (\\-) to create",
       "column's header.",
       "",
       "**Example:**",
       "",
       "```",
       "  | Syntax    | Description |",
       "  |-----------|-------------|",
       "  | Header    | _Title_     |",
       "  | Paragraph | `Text`      |",
       "  | Body      | Close       |",
       "```",
       "",
       "**Result:**",
       "",
       "| Syntax    | Description |",
       "|-----------|-------------|",
       "| Header    | _Title_     |",
       "| Paragraph | `Text`      |",
       "| Body      | Close       |",
       "",
       "",
       "## Code Blocks",
       "",
       "To create code blocks, ident every line of the block by at least four spaces or one tab.",
       "",
       "**Example:**",
       "",
       "```",
       "    COPY /V /Y /B image.jpeg d:\\",
       "    DIR /L /C /X d:\\",
       "    DEL /F /Q image.jpeg",
       "```",
       "",
       "**Result:**",
       "",
       "    COPY /V /Y /B image.jpeg d:\\",
       "    DIR /L /C /X d:\\",
       "    DEL /F /Q image.jpeg",
       "",
       "",
       "## Fenced Code Blocks",
       "",
       "Markdown allows you to create code blocks using *fenced code blocks*. Use *three tick marks*",
       "(&#96;&#96;&#96;) or *three tildes* (&#126;&#126;&#126;) on the lines before and after the code block. Syntax",
       "highlighting for *wxBasic* is done automatically.",
       "",
       "**Example:**",
       "",
       "    &#96;&#96;&#96;",
       "      'ANSI BASIC Style",
       "      INPUT \"Enter value: \", X",
       "      IF X<10 THEN PRINT \"Ans: \", X, \" is a small number\"",
       "	",
       "      //wxWidgets Style",
       "      Dim y = wxGetTextFromUser( \"Enter value:\", \"Data\" ) ",
       "      If y < 10 Then",
       "         Dim Dialog = New wxFrame( Nothing, -1, \"Ans: \" & y & \" is a small number\" )",
       "         Dialog.Show( True )",
       "      End If",
       "    &#96;&#96;&#96;",
       "",
       "**Result:**",
       "",
       "```",
       "  'ANSI BASIC Style",
       "  INPUT \"Enter value: \", X",
       "  IF X<10 THEN PRINT \"Ans: \", X, \" is a small number\"",
       "  ' ",
       "  //wxWidgets Style",
       "  Dim y = wxGetTextFromUser( \"Enter value:\", \"Data\" ) ",
       "  If y < 10 Then",
       "     Dim Dialog = New wxFrame( Nothing, -1, \"Ans: \" & y & \" is a small number\" )",
       "     Dialog.Show( True )",
       "  End If	 ",
       "```",
       "",
       "",
       "## Comments",
       "",
       "To add a comment, place text *inside brackets* followed by a *colon, a space, and a pound sign* (e.g., `[comment]:&nbsp;#`).",
       "You should put blank lines before and after a comment.",
       "",
       "**Example:**",
       "",
       "```",
       "    Here´s a paragraph that will be visible. ",
       "",
       "    [This is a comment that will be hidden.]:&nbsp;# ",
       "",
       "    And here´s another paragraph that´s visible. ",
       "```",
       "	",
       "**Result:**",
       "",
       "Here's a paragraph that will be visible.",
       "",
       "[This is a comment that will be hidden.]: # ",
       "",
       "And here's another paragraph that's visible.",
       "",
       "",
       "_________________________________________________",
       "",
       "^Copyleft (c) 2026 by Agustin Benitez Hernandez^"]
End Function


Function Icon()
Return {
    "32 32 10 1",
    " 	c None",
    ".	c #000000",
    "+	c #FFFFFF",
    "@	c #549A4F",
    "#	c #FFF7F7",
    "$	c #D2CFDB",
    "%	c #FF0000",
    "&	c #0000FF",
    "*	c #FFFF00",
    "=	c #0E9C0E",
    "  ............................  ",
    " .++++++++++++++++++++++++++++. ",
    ".+%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#............................+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.********.========.&&&&&+.",
    ".#%%%%.+++++.......+++++.&&&&&+.",
    ".#%%%%.+++++.......+++++.&&&&&+.",
    ".+++++++...............++++++++.",
    ".++++++++.............$++++++++.",
    ".+++++++++...........$+++++++++.",
    ".+++++++++#.........$++++++++++.",
    ".++++++++++#.......$+++++++++++.",
    ".+++++++++++#.....$++++++++++++.",
    ".++++++++++++#...$+++++++++++++.",
    ".++++++++++++++.@++++++++++++++.",
    " .++++++++++++++++++++++++++++. ",
    "  ............................  "
    }
End Function
